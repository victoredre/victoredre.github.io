---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";

const allPost = await getCollection("posts");
const sortedPosts = allPost.sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<Layout title="Ing. Victor Eduardo Resendiz Villegas" description="A list of my blog posts" scrollSmooth={false}>
    <>
        <section class="border-bottom">
            <div class="mb-4">
                <h2 class="text-3xl font-bold mb-8">Laboratorio</h2>
            </div>
        </section>

        <section class="flex flex-col gap-8">
            {sortedPosts.length > 0 ? (
                sortedPosts.map((post) => (
    <PostCard
    id={post.id}
    title={post.data.title}
    description={post.data.description}
    publishDate={post.data.publishDate}
    tags={post.data.tags || []}
    cover={post.data.cover}
/>
                ))
            ) : (
                <p>No posts found.</p>
            )}
        </section>
    </>
</Layout>
